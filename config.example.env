# =============================================================================
# svensk-data-och-analys — Konfigurationsmall
# Kopiera till .env och fyll i värden. .env checkas aldrig in i git.
# =============================================================================

# -----------------------------------------------------------------------------
# Databas — PostgreSQL eller SQLite (välj vid installation)
# -----------------------------------------------------------------------------

# postgres ger pgvector, samtidighet och bättre prestanda.
# sqlite ger en enda fil och snabb installation.
DOA_DB_BACKEND=postgres

# PostgreSQL: byt användarnamn, lösenord och databasnamn
DOA_DB_URL=postgresql://<ANVÄNDARE>:<LÖSENORD>@localhost:5432/<DATABASNAMN>

# SQLite: en lokal fil, ingen serverinstallation
# DOA_DB_URL=sqlite:///<SOKVAG_TILL_CACHE>.db

# -----------------------------------------------------------------------------
# MCP-transport — stdio när klienten startar servern, http för delad drift
# -----------------------------------------------------------------------------

DOA_MCP_TRANSPORT=stdio
DOA_MCP_HOST=127.0.0.1
DOA_MCP_PORT=8001

# Obligatorisk när TRANSPORT=http (uppstart avbryts om den är tom).
# Generera med: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DOA_MCP_API_KEY=

# -----------------------------------------------------------------------------
# FastAPI (Excel / Power Query) — lyssnar på localhost
# -----------------------------------------------------------------------------

DOA_API_PORT=8000

# -----------------------------------------------------------------------------
# Mellanlagring av filbaserade källor
# -----------------------------------------------------------------------------

# Filer som hämtas ur öppna data-kataloger och från myndigheter utan API
# sparas i databasen så att de inte hämtas om vid varje fråga. De går att
# hämta igen och hör därför inte hemma permanent — hållbarheten säger hur
# länge en hämtning behålls. Den schemalagda synken rensar det som passerat;
# cli/rensa_mellanlager.py gör det för hand.
DOA_MELLANLAGRING_DAGAR=30

# -----------------------------------------------------------------------------
# Schemalagd synk — cli/synka.py --installera-schema
# -----------------------------------------------------------------------------

# launchd (standard på macOS) eller cron (standard på övriga). launchd kör
# ett missat jobb när datorn vaknar; cron hoppar över det.
# DOA_SYNK_SCHEMALAGGARE=launchd

# Tidpunkt i cron-format (minut timme * * *). Kör du flera schemalagda jobb
# mot samma källor, sprid dem över natten.
# DOA_SYNK_SCHEMA=45 4 * * *

# Namn på launchd-tjänsten (macOS)
# DOA_SYNK_ETIKETT=com.magnuskolsjo.doa-synk

# Antal dagar synkloggarna i logs/ behålls
# DOA_SYNK_LOGG_DAGAR=30

# Python-miljö för den schemalagda synken och Excel-tilläggets tjänst.
# Standard är .venv i repot.
# DOA_VENV=/<SOKVAG_TILL_VENV>

# --- Källor som byter adress vid varje publicering ---------------------------
# SKR, Tillväxtverket, SCB:s DeSO/RegSO-koppling och val.se lägger en ny
# fil på en ny adress när de publicerar. Adressen kan därför inte stå i
# koden. Den som står här används av synkverktygen när ingen adress anges,
# och av den schemalagda synken: byter källan ut filen på samma adress
# hämtas den om, och byts adressen här hämtas den nya vid nästa körning.
# Ange alltid den senaste årgången — synken skriver över det som ligger.
# DOA_TV_KOMMUNTYPER_URL=
# DOA_SKR_KOMMUNGRUPP_URL=
# DOA_TV_FA_REGION_URL=
# DOA_DESO_REGSO_URL=
# DOA_VALDISTRIKT_URL=
# DOA_VALDISTRIKT_GEOM_URL=


# -----------------------------------------------------------------------------
# Excel-tillägget — HTTPS-tjänsten som excel-tillagg/setup.sh installerar
# -----------------------------------------------------------------------------

# Katalog för det självsignerade localhost-certifikatet. Standard är
# certs/localhost i repot. Flera lokala HTTPS-tjänster bör dela certifikat.
# DOA_TLS_KATALOG=/<SOKVAG_TILL_CERTKATALOG>

# Namn på launchd-tjänsten (macOS)
# DOA_LAUNCHD_ETIKETT=com.magnuskolsjo.doa-api-https

# Pythonmiljön som kör API:t. Standard är .venv i repot.
# DOA_VENV=/<SOKVAG_TILL_VENV>

# -----------------------------------------------------------------------------
# Embeddings och hybridsökning
# -----------------------------------------------------------------------------

# Tränad för semantisk likhet (768 dim). Inte bert-base-swedish-cased.
DOA_EMBEDDING_MODEL=KBLab/sentence-bert-swedish-cased

# Viktning i hybridsökningen — justeras utan kodändring
DOA_FTS_WEIGHT=0.35
DOA_VEC_WEIGHT=0.65

# -----------------------------------------------------------------------------
# Query-expansion (valfritt) — OpenAI-kompatibel endpoint
# -----------------------------------------------------------------------------

DOA_QUERY_EXPANSION_ENABLED=false
DOA_QUERY_EXPANSION_URL=http://localhost:11434/v1
DOA_QUERY_EXPANSION_MODEL=llama3

# Promptfil för termexpansion (relativ sökväg från projektroten)
DOA_QUERY_EXPANSION_PROMPT_FILE=prompts/expansion_prompt.txt

# -----------------------------------------------------------------------------
# PxWeb-myndigheter — versionsöverstyrning per källa
# -----------------------------------------------------------------------------
#
# Baslinjen finns i data_och_analys/klienter/myndigheter.py. PxWeb-
# myndigheterna byter stegvis från v1 till v2. Sätt en eller flera av
# raderna nedan när en källa ska flyttas innan baslinjen uppdateras.
#
#   DOA_PXWEB_<NAMN>_VERSION     -> 1 eller 2
#   DOA_PXWEB_<NAMN>_BAS_URL     -> hel URL utan slut-snedstreck
#   DOA_PXWEB_<NAMN>_MAX_CELLER  -> heltal (relevant för v2)
#
# <NAMN> är myndighetens ID i versaler. Exempel — flytta Jordbruksverket
# till v2 utan att vänta på release:
#
# DOA_PXWEB_JORDBRUKSVERKET_VERSION=2
# DOA_PXWEB_JORDBRUKSVERKET_BAS_URL=https://statistik.sjv.se/PXWeb/api/v2

# -----------------------------------------------------------------------------
# Externa API-nycklar
# -----------------------------------------------------------------------------

# Lantmäteriet OAuth2 client_credentials — registreras på
# apimanager.lantmateriet.se/devportal. Skapa en application, prenumerera
# på det API du behöver (t.ex. OGC-Features), generera nycklar.
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
# Lantmäteriet OAuth-scopes — space-separerade. Tom => använd baslinjen
# (`ogc-features:ngp.read`). Sätt om du behöver fler scopes,
# t.ex. "ogc-features:ngp.read ogc-features:hydrografi.read".
LANTMATERIET_OAUTH_SCOPES=
